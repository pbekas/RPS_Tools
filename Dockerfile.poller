# Vonage poller / webhook worker for ECS Fargate.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    && curl -fsSL \
      https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem \
      -o /etc/ssl/certs/aws-rds-global-bundle.pem \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV VBC_POLLER_ENABLED=1
ENV VBC_POLLER_INTERVAL_SECONDS=300
ENV VBC_POLLER_LOOKBACK_MINUTES=30
ENV VBC_POLLER_MAX_PER_CYCLE=50
ENV VBC_POLLER_SAFETY_LOOKBACK_HOURS=6
ENV VBC_POLLER_BACKFILL_DAYS=2
ENV VBC_POLLER_BACKFILL_INTERVAL_HOURS=24
ENV VBC_POLLER_BACKFILL_MAX=200
ENV VBC_POLLER_MAX_CALL_LOGS=400

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "webhook:app", "--host", "0.0.0.0", "--port", "8080"]
