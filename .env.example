# Google OAuth (Workspace SSO) — restrict to allowed domains in app logic
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# App URL used for OAuth redirect (local ALB / CloudFront URL)
APP_URL=http://localhost:8501

# Firestore: paste the full Firebase service account JSON as a single-line string
# (optional while migrating; can move to DynamoDB later)
FIREBASE_SERVICE_ACCOUNT=

# Database migration controls. Keep Firestore active until PostgreSQL backfill
# and reconciliation are complete.
DB_BACKEND=firestore
DB_DUAL_WRITE=0
# PostgreSQL requires verified TLS in production:
# postgresql://user:password@host:5432/rps_call_qa?sslmode=verify-full
DATABASE_URL=

# Optional: GCS bucket (legacy)
GCS_BUCKET=

# AWS — hosting, recordings, Transcribe, Bedrock
AWS_REGION=us-east-1
S3_BUCKET=
# Audit / scoring model (cheap + fast). Enable in Bedrock console:
# us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional cheaper alt: amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional: stronger model for weekly coaching only
BEDROCK_COACHING_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
TRANSCRIBE_LANGUAGE_CODE=en-US

# Optional: classic Vonage Voice API (webhooks)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
WEBHOOK_PORT=8080

# Vonage Business Communications (UC) — https://apimanager.uc.vonage.com
VBC_CLIENT_ID=
VBC_CLIENT_SECRET=
VBC_USERNAME=
VBC_PASSWORD=
VBC_ACCOUNT_ID=self

# Near-real-time poller (webhook service or scripts/poll_vonage_recordings.py)
VBC_POLLER_ENABLED=0
VBC_POLLER_INTERVAL_SECONDS=300
VBC_POLLER_LOOKBACK_MINUTES=30
VBC_POLLER_MAX_PER_CYCLE=25

# Alerts — Google Chat incoming webhooks
# Critical / medical Call Alerts space
GCHAT_WEBHOOK_URL=
# Missed / abandoned / voicemail space (separate from Call Alerts)
GCHAT_MISSED_CALLS_WEBHOOK_URL=
ALERTS_ENABLED=1
# Skip Chat alerts for CDRs older than this (avoids noise on long backfills)
MISSED_ALERT_MAX_AGE_MINUTES=120
# Optional extra spike summary (in addition to per-call alerts)
MISSED_ALERT_WINDOW_MINUTES=30
MISSED_ALERT_THRESHOLD=8
# Contracts expiry / notice — optional separate Chat space (never uses GCHAT_WEBHOOK_URL)
GCHAT_CONTRACTS_WEBHOOK_URL=
CONTRACT_ALERTS_ENABLED=1
CONTRACT_ALERT_DAYS=90
# Time clock — optional separate Chat space for long open punch reminders
GCHAT_TIME_CLOCK_WEBHOOK_URL=
TIME_CLOCK_ALERTS_ENABLED=1

# Twilio — SMS patient on missed inbound CDR (off until credentials + flag set)
# Runs from CDR sync (poller / scripts/sync_vonage_call_logs.py)
TWILIO_MISSED_SMS_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: clinic main line inserted into the default template via {main_line}
TWILIO_MISSED_SMS_MAIN_LINE=
# Optional custom body; supports {main_line}
# TWILIO_MISSED_SMS_MESSAGE=Relevium received your call and will call you back. Call {main_line} if needed.
TWILIO_MISSED_SMS_COOLDOWN_MINUTES=90
# Skip CDRs older than this (avoids SMS on long backfills / lookbacks)
TWILIO_MISSED_SMS_MAX_AGE_MINUTES=120
# Optional Twilio delivery status callback (POST form to poller)
# TWILIO_STATUS_CALLBACK_URL=http://127.0.0.1:8080/webhooks/twilio/sms-status

# Next.js → poller ops (re-analyze + upload). Shared secret on both sides.
# Local: run uvicorn on 8080 and point Next at it.
POLLER_INTERNAL_URL=http://127.0.0.1:8080
OPS_INTERNAL_TOKEN=dev-change-me

ALLOWED_EMAIL_DOMAIN=releviumpain.com
# Comma-separated domains (overrides ALLOWED_EMAIL_DOMAIN when set)
ALLOWED_EMAIL_DOMAINS=releviumpain.com,octanesolutiongroup.com
# Auto-promote these emails to Admin with Call QA + Contracts on login
BOOTSTRAP_ADMIN_EMAILS=pb@octanesolutiongroup.com,pb@releviumpain.com,pete@releviumpain.com
