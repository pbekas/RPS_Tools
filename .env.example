# Google OAuth (Workspace SSO) — restrict to @releviumpain.com in app logic
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# App URL used for OAuth redirect (local ALB / CloudFront URL)
APP_URL=http://localhost:8501

# Firestore: paste the full Firebase service account JSON as a single-line string
# (optional while migrating; can move to DynamoDB later)
FIREBASE_SERVICE_ACCOUNT=

# Optional: GCS bucket (legacy)
GCS_BUCKET=

# AWS — hosting, recordings, Transcribe, Bedrock
AWS_REGION=us-west-2
S3_BUCKET=
# Enable model access in Bedrock console for this ID (or an inference profile ARN)
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
TRANSCRIBE_LANGUAGE_CODE=en-US

# Optional: classic Vonage Voice API (webhooks)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
WEBHOOK_PORT=8080

# Vonage Business Communications (UC) — https://apimanager.uc.vonage.com
VBC_CLIENT_ID=
VBC_CLIENT_SECRET=
VBC_USERNAME=
VBC_PASSWORD=
VBC_ACCOUNT_ID=self

ALLOWED_EMAIL_DOMAIN=releviumpain.com
